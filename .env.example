# --- Supabase (auth + Postgres) ---
# For a self-hosted Supabase stack, NEXT_PUBLIC_SUPABASE_URL is the Kong
# gateway URL (e.g. https://supabase.yourdomain.com), and the anon/service
# role keys are the JWTs you configured in that stack's .env (signed with
# your own JWT_SECRET), not ones issued by supabase.com.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxx
SUPABASE_SERVICE_ROLE_KEY=xxxx          # server-only, never expose to client
# Pooled connection (Supavisor/pgbouncer, typically port 6543) — used by the
# running app.
DATABASE_URL=postgresql://postgres:xxxx@db.xxxx.supabase.co:6543/postgres?pgbouncer=true
# Direct, unpooled connection (typically port 5432) — used only for
# `prisma migrate deploy` at container startup. See prisma/schema.prisma.
DIRECT_URL=postgresql://postgres:xxxx@db.xxxx.supabase.co:5432/postgres

# --- MinIO (S3-compatible object storage, self-hosted via infra/docker-compose.yml) ---
# There's no separate IAM user here — MINIO_ACCESS_KEY/MINIO_SECRET_KEY are
# just the same MINIO_ROOT_USER/MINIO_ROOT_PASSWORD values you set in
# infra/.env (that file configures the MinIO container itself; these
# configure the app as a client of it). You choose both, e.g.
# `openssl rand -base64 32` for the password.
# MUST be a public, TLS-terminated hostname behind your reverse proxy —
# unlike Meilisearch/Ollama below, presigned URLs go straight to the end
# user's browser, not just server-to-server.
# One-time setup after the container is up: create the MINIO_BUCKET bucket
# (nothing does this automatically) via the MinIO console (port 9001) or
# `mc mb`.
MINIO_ENDPOINT=https://storage.yourdomain.com
MINIO_ACCESS_KEY=xxxx
MINIO_SECRET_KEY=xxxx
MINIO_BUCKET=fireflink-docs

# --- Meilisearch (self-hosted via infra/docker-compose.yml) ---
# MEILISEARCH_API_KEY is the same MEILI_MASTER_KEY you set in infra/.env
# (again, you choose it). Only ever called server-side (never the
# browser), so if the app and Meilisearch run in the same docker-compose
# project, point this at the internal service name instead of a public
# domain: http://meilisearch:7700 — no public DNS/TLS needed for it.
# One-time setup after it's up: `npm run search:setup` (configures the
# index's searchable/filterable attributes — dashboard filters silently
# return nothing without this).
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_API_KEY=xxxx

# --- Ollama (self-hosted open-source LLM via infra/docker-compose.yml) ---
# Also server-side only — same reasoning as Meilisearch above, use the
# internal service name rather than exposing it publicly.
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b

# --- App ---
NEXT_PUBLIC_APP_URL=https://your-app.onrender.com
ALLOWED_EMAIL_DOMAINS=fireflink.com     # comma-separated; only these domains can be invited

# --- Google Chat webhooks (optional — notifications no-op if unset) ---
GCHAT_WEBHOOK_URL=xxxx                  # whole-team space: publish/stale/revoke announcements
GCHAT_MANAGER_WEBHOOK_URL=xxxx          # manager-only space: pending-review + retention alerts

# --- LibreOffice (optional — PPT/Excel/Word -> PDF preview conversion) ---
# Only needed if soffice isn't on PATH; falls back gracefully (no PDF preview) if unset/missing.
# LIBREOFFICE_PATH=/usr/bin/soffice
