# Config for the containers themselves, read by infra/docker-compose.yml
# (Compose auto-loads a file named exactly ".env" from this directory).
# This is separate from the repo-root .env, which configures the app as a
# *client* of these same services — see the comments there for how the
# values below map over (MINIO_ROOT_USER/PASSWORD -> MINIO_ACCESS_KEY/
# SECRET_KEY, MEILI_MASTER_KEY -> MEILISEARCH_API_KEY).
#
# Copy this file to infra/.env and fill in real values. Never commit the
# result — infra/.env is git-ignored on purpose (this repo is public).

# --- MinIO ---
# You choose both — e.g. `openssl rand -base64 24` for the password. Avoid
# reusing weak local-dev values (like "admin"/"admin12345") in production.
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change-me

# --- Meilisearch ---
MEILI_MASTER_KEY=change-me

# --- Caddy (reverse proxy + automatic TLS — see infra/Caddyfile) ---
# Both must point at this host's public IP via DNS before `docker compose
# up`, or Caddy can't get Let's Encrypt certificates for them.
APP_DOMAIN=app.yourdomain.com
MINIO_ENDPOINT_DOMAIN=storage.yourdomain.com
# Optional — only needed if you've uncommented the console block in
# infra/Caddyfile. Leave as-is (or anything) otherwise; unused if that
# block stays commented out.
MINIO_CONSOLE_DOMAIN=storage-console.yourdomain.com

# --- Build-time app config (yes, duplicated from the root .env — see why) ---
# next build compiles NEXT_PUBLIC_* vars directly into the browser-side JS
# bundle, so they have to be correct at *build* time, not just container
# runtime. docker-compose.yml passes them to the image build as
# build.args, and Compose only resolves ${...} in this file from THIS
# directory's .env — it does NOT read ../.env for that purpose (env_file:
# only injects vars into a running container, which is too late for
# anything already compiled into the bundle). So: same values as the root
# .env's NEXT_PUBLIC_SUPABASE_URL/NEXT_PUBLIC_SUPABASE_ANON_KEY/
# NEXT_PUBLIC_APP_URL, copied here too. If you ever rotate the Supabase
# anon key or change domains, update both files and rebuild
# (`docker compose up -d --build app`) — a runtime-only env change won't
# pick it up.
NEXT_PUBLIC_SUPABASE_URL=https://supabase.yourdomain.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxx
NEXT_PUBLIC_APP_URL=https://app.yourdomain.com
